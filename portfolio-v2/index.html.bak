<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>BB visual</title>
  <link rel="icon" type="image/png" href="media/favicon.png">
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="projekty/projekty.css">
</head>
<body>

  <!-- Nawigacja -->
  <header class="nav">
    <a class="nav-logo" href="#start">BARTEK BRUZDA</a>
    <nav class="nav-links">
      <a href="#projekty">Projekty</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
  </header>

  <!-- HERO -->
  <section class="hero" id="start">

    <!-- Miejsce na wizualizację / wideo showreel.
         Później: <video class="hero-video" src="media/hero.mp4" autoplay muted loop playsinline></video> -->
    <div class="hero-visual">
      <span class="ring"></span>
      <!-- Tu lądują Twoje packshoty (PNG z przezroczystym tłem) z folderu media/.
           Podmień nazwę pliku w src i opis w alt. data-depth = siła ruchu za myszką. -->
      <img class="shape p1" src="media/hero-1.png" alt="Łóżko"           data-depth="0.6">
      <img class="shape p2" src="media/hero-2.png" alt="Łóżko z pojemnikiem" data-depth="1.2">
      <img class="shape p3" src="media/hero-3.png" alt="Regał"           data-depth="0.8">
      <img class="shape p4" src="media/hero-4.png" alt="Krzesło"         data-depth="1.5">
      <img class="shape p5" src="media/hero-5.png" alt="Stolik"          data-depth="1.0">
      <img class="shape p6" src="media/hero-6.png" alt="Ławka"           data-depth="0.7">
      <a class="shape box b1" href="#projekty" data-depth="1.1"><span class="noise"><i></i><i></i><i></i><i></i></span><span class="box-label">PROJEKTY</span></a>
      <a class="shape box b2" href="#o-mnie"   data-depth="0.9"><span class="noise"><i></i><i></i><i></i><i></i></span><span class="box-label">O MNIE</span></a>
      <a class="shape box b3" href="#kontakt"  data-depth="1.3"><span class="noise"><i></i><i></i><i></i><i></i></span><span class="box-label">KONTAKT</span></a>

    </div>

    <div class="hero-copy">
      <p class="hero-year">2026</p>
      <h1 class="hero-title">PORTFOLIO</h1>
      <div class="hero-meta-row">
        <div class="hero-meta">
          <span class="hairline"></span>
          <p>BARTEK BRUZDA</p>
        </div>
        <div class="hero-meta hero-meta-right">
          <span class="hairline"></span>
          <p>ARCHITECTURAL<br>&amp; INTERIOR<br>VISUALIZATION</p>
        </div>
      </div>
    </div>
     <p class="scroll-hint" aria-hidden="true"><span class="scroll-line"></span>SCROLL</p>
  </section>
 <!-- SHOWREEL (bez tytułu). Podmień media/showreel.mp4 na swój plik. -->
  <section class="reel" id="reel">
    <div class="reel-panel">
      <span class="crop tl"></span><span class="crop tr"></span>
      <span class="crop bl"></span><span class="crop br"></span>
      <video class="reel-video" src="media/showreel.mp4" poster="media/showreel-poster.jpg"
             autoplay muted loop playsinline preload="metadata"></video>
    </div>
  </section>

  <!-- PROJEKTY: karuzela 3D -->
<!-- ===== SEKCJA PROJEKTY (karuzela 3D) – wklej w miejsce starej karuzeli CONTENT ===== -->
<section class="rs-section" id="projekty">
  <h2 class="section-title reveal">PROJEKTY</h2>

  <div class="rs-stage" id="rs-stage">
    <div class="rs-scene">
      <div class="rs-world" id="rs-world">
        <div class="rs-floor">
          <div class="rs-tex"></div>
          <svg class="rs-floor-labels" viewBox="-1053 -1053 2106 2106" aria-hidden="true">
            <defs>
              <path id="rs-pathInt" d="M -548 0 A 548 548 0 0 0 548 0"/>
              <path id="rs-pathExt" d="M -868 0 A 868 868 0 0 0 868 0"/>
            </defs>
            <text><textPath href="#rs-pathInt" startOffset="29%" text-anchor="middle">INTERIOR</textPath></text>
            <text><textPath href="#rs-pathExt" startOffset="73%" text-anchor="middle">EXTERIOR</textPath></text>
          </svg>
        </div>
        <div class="rs-ring" id="rs-ring-exterior"></div>
        <div class="rs-ring" id="rs-ring-interior"></div>
      </div>
    </div>
  </div>

  <p class="rs-caption" id="rs-caption"></p>
  <a class="rs-all" href="#">ZOBACZ WSZYSTKIE PRACE →</a>

  <div class="rs-lightbox" id="rs-lightbox" hidden>
    <button class="rs-lb-close" id="rs-lbClose" type="button">ZAMKNIJ ✕</button>
    <button class="rs-lb-arrow rs-lb-prev" id="rs-lbPrev" type="button" aria-label="Poprzednie">‹</button>
    <img class="rs-lb-img" id="rs-lbImg" alt="">
    <button class="rs-lb-arrow rs-lb-next" id="rs-lbNext" type="button" aria-label="Następne">›</button>
    <p class="rs-lb-cap" id="rs-lbCap"></p>
  </div>
</section>
<!-- ===== KONIEC SEKCJI PROJEKTY ===== -->

  <!-- O MNIE -->
<section class="about" id="o-mnie">
  <div class="about-inner">
    <h2 class="section-title about-title reveal">O MNIE</h2>

    <figure class="about-photo reveal">
      <img src="media/o-mnie.png" alt="Bartek">
    </figure>

    <p class="about-text reveal">
      Architekt i CGI Artist z ponad 6-letnim doświadczeniem w tworzeniu wizualizacji i animacji 3D dla międzynarodowych projektów architektonicznych, urbanistycznych i produktowych. Pełna, samodzielna odpowiedzialność za realizację shotów – od koncepcji, przez modelowanie, teksturowanie i oświetlenie, po finalny render. Doświadczenie w pracy przy wysokobudżetowych, prestiżowych projektach dla bliskowschodnich konsorcjów deweloperskich oraz przy powtarzalnej, wolumenowej produkcji wizualizacji produktowych dla marek meblowych i wnętrzarskich z Wielkiej Brytanii i Skandynawii. Aktywnie rozwija warsztat o narzędzia AI (ComfyUI, Figma Weave), łącząc tradycyjny CGI z nowymi technologiami.
    </p>
  </div>
</section>

  <!-- KONTAKT -->
  <footer class="footer" id="kontakt">
    <h2 class="section-title reveal">KONTAKT</h2>
    <p class="footer-mail reveal">bartek-bruzda@wp.pl</p>
    <p class="footer-small reveal">tel. +512 231 988</p>
    <p class="footer-small reveal">Poznań, Polska</p>
<ul class="about-social footer-social reveal">
    <li><a href="https://www.behance.net/bartekbruzda" target="_blank" rel="noopener" aria-label="Behance">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h4.8a2.4 2.4 0 0 1 0 4.8H3M3 11.8h5.3a2.6 2.6 0 0 1 0 5.2H3M3 7v10M14 7.5h6M14 13.5h6.2a3.1 3.1 0 1 0-.9 2.5"/></svg>
    </a></li>
    <li><a href="https://www.linkedin.com/in/bartek-bruzda-5a3670182/" target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V16M11.5 16v-5.5M11.5 13c0-1.5 1-2.5 2.4-2.5s2.1 1 2.1 2.6V16"/><circle cx="8" cy="7.8" r=".7" fill="currentColor"/></svg>
    </a></li>
    <li><a href="https://www.instagram.com/bart.render" target="_blank" rel="noopener" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".7" fill="currentColor"/></svg>
    </a></li>
  </ul>
</footer>

  <script src="script.js"></script>
  <script src="projekty/projekty.js"></script>
</body>
</html>
